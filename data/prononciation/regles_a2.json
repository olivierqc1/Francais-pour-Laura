    {
      "titre": {
        "es": "La liaison — unir las palabras",
        "ca": "La liaison — unir les paraules"
      },
      "description": {
        "es": "Una consonante final muda SÍ se pronuncia si la palabra siguiente empieza por vocal. <i>les‿amis</i> = «les-zami».",
        "ca": "Una consonant final muda SÍ es pronuncia si la paraula següent comença per vocal. <i>les‿amis</i> = «les-zami»."
      },
      "exemples": [
        {
          "mot": "les amis",
          "es": "los amigos",
          "ca": "els amics"
        },
        {
          "mot": "vous avez",
          "es": "ustedes tienen",
          "ca": "vosaltres teniu"
        },
        {
          "mot": "un petit enfant",
          "es": "un niño pequeño",
          "ca": "un nen petit"
        },
        {
          "mot": "nous avons",
          "es": "nosotros tenemos",
          "ca": "nosaltres tenim"
        },
        {
          "mot": "très important",
          "es": "muy importante",
          "ca": "molt important"
        }
      ]
    },
