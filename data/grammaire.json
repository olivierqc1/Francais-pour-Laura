{
  "modules": [
    {
      "titre": {
        "es": "Los artículos",
        "ca": "Els articles"
      },
      "explication": {
        "es": "<b>Definidos</b>: le (m), la (f), les (pl). <b>Indefinidos</b>: un, une, des. <b>Partitivos</b> (una cantidad indefinida — ¡no existe en español!): du (m), de la (f), de l' (ante vocal), des (pl).",
        "ca": "<b>Definits</b>: le (m), la (f), les (pl). <b>Indefinits</b>: un, une, des. <b>Partitius</b> (una quantitat indefinida — no existeix en castellà!): du (m), de la (f), de l' (davant vocal), des (pl)."
      },
      "exercices": [
        {
          "phrase": "J'aime ___ hockey.",
          "reponse": "le"
        },
        {
          "phrase": "Elle regarde ___ télévision.",
          "reponse": "la"
        },
        {
          "phrase": "Nous visitons ___ musées.",
          "reponse": "les"
        },
        {
          "phrase": "Il y a ___ chat dans le jardin.",
          "reponse": "un"
        },
        {
          "phrase": "Je voudrais ___ pomme, s'il vous plaît.",
          "reponse": "une"
        },
        {
          "phrase": "Il achète ___ légumes au marché.",
          "reponse": "des"
        },
        {
          "phrase": "Je mange ___ poutine au restaurant.",
          "reponse": "de la"
        },
        {
          "phrase": "Tu bois ___ café ?",
          "reponse": "du"
        },
        {
          "phrase": "Elle boit ___ eau.",
          "reponse": "de l'"
        }
      ]
    },
    {
      "titre": {
        "es": "La negación",
        "ca": "La negació"
      },
      "explication": {
        "es": "La negación se forma con <b>ne + verbo + pas</b>. Variantes: <b>ne...jamais</b> (nunca), <b>ne...plus</b> (ya no), <b>ne...rien</b> (nada), <b>ne...personne</b> (nadie). En Quebec el «ne» a menudo no se pronuncia, ¡pero sí se escribe!",
        "ca": "La negació es forma amb <b>ne + verb + pas</b>. Variants: <b>ne...jamais</b> (mai), <b>ne...plus</b> (ja no), <b>ne...rien</b> (res), <b>ne...personne</b> (ningú). Al Quebec el «ne» sovint no es pronuncia, però s'escriu!"
      },
      "exercices": [
        {
          "phrase": "Je ___ mange pas de viande.",
          "reponse": "ne"
        },
        {
          "phrase": "Il ne mange ___ de légumes.",
          "reponse": "pas"
        },
        {
          "phrase": "Elle ne fume ___.",
          "reponse": "jamais"
        },
        {
          "phrase": "Nous n'avons ___ d'argent.",
          "reponse": "plus"
        },
        {
          "phrase": "Je ne comprends ___.",
          "reponse": "rien"
        },
        {
          "phrase": "Tu ne bois ___ d'alcool ?",
          "reponse": "pas"
        },
        {
          "phrase": "Il n'y a ___ dans la maison.",
          "reponse": "personne"
        },
        {
          "phrase": "Ils ne sortent ___ le soir.",
          "reponse": "jamais"
        }
      ]
    },
    {
      "titre": {
        "es": "El género y los adjetivos",
        "ca": "El gènere i els adjectius"
      },
      "explication": {
        "es": "El adjetivo concuerda en <b>género</b> y <b>número</b>. Femenino: a menudo +e (petit → petite). Plural: +s. Algunos son irregulares: beau → belle, blanc → blanche.",
        "ca": "L'adjectiu concorda en <b>gènere</b> i <b>nombre</b>. Femení: sovint +e (petit → petite). Plural: +s. Alguns són irregulars: beau → belle, blanc → blanche."
      },
      "exercices": [
        {
          "phrase": "La voiture est ___. (petit)",
          "reponse": "petite"
        },
        {
          "phrase": "Les fleurs sont ___. (beau)",
          "reponse": "belles"
        },
        {
          "phrase": "C'est un ___ homme. (grand)",
          "reponse": "grand"
        },
        {
          "phrase": "Une femme ___. (heureux)",
          "reponse": "heureuse"
        },
        {
          "phrase": "Les chats sont ___. (noir)",
          "reponse": "noirs"
        },
        {
          "phrase": "Une robe ___. (blanc)",
          "reponse": "blanche"
        },
        {
          "phrase": "Des livres ___. (intéressant)",
          "reponse": "intéressants"
        },
        {
          "phrase": "La neige est ___. (froid)",
          "reponse": "froide"
        }
      ]
    },
    {
      "titre": {
        "es": "Los pronombres sujeto",
        "ca": "Els pronoms subjecte"
      },
      "explication": {
        "es": "<b>je</b> (yo), <b>tu</b> (tú), <b>il/elle</b> (él/ella), <b>nous</b> (nosotros), <b>vous</b> (vosotros/usted), <b>ils/elles</b> (ellos/ellas). En Quebec, <b>on</b> se usa muchísimo en lugar de «nous».",
        "ca": "<b>je</b> (jo), <b>tu</b> (tu), <b>il/elle</b> (ell/ella), <b>nous</b> (nosaltres), <b>vous</b> (vosaltres/vostè), <b>ils/elles</b> (ells/elles). Al Quebec, <b>on</b> s'usa moltíssim en lloc de «nous»."
      },
      "exercices": [
        {
          "phrase": "___ suis québécois.",
          "reponse": "je"
        },
        {
          "phrase": "___ es espagnole.",
          "reponse": "tu"
        },
        {
          "phrase": "___ mange une pomme. (él)",
          "reponse": "il"
        },
        {
          "phrase": "___ sommes à Barcelone.",
          "reponse": "nous"
        },
        {
          "phrase": "___ êtes prêts ?",
          "reponse": "vous"
        },
        {
          "phrase": "___ parlent français. (ellas)",
          "reponse": "elles"
        },
        {
          "phrase": "___ va à la cabane à sucre ! (nosotros, familiar)",
          "reponse": "on"
        },
        {
          "phrase": "Marie et Paul ? ___ arrivent demain.",
          "reponse": "ils"
        }
      ]
    },
    {
      "titre": {
        "es": "Las preposiciones y el lugar",
        "ca": "Les preposicions i el lloc"
      },
      "explication": {
        "es": "<b>à</b> + ciudad (à Barcelone), <b>en</b> + país femenino (en France), <b>au</b> + país masculino (au Canada). Lugar: <b>dans</b> (dentro), <b>sur</b> (sobre), <b>sous</b> (debajo), <b>chez</b> (en casa de).",
        "ca": "<b>à</b> + ciutat (à Barcelone), <b>en</b> + país femení (en France), <b>au</b> + país masculí (au Canada). Lloc: <b>dans</b> (dins), <b>sur</b> (sobre), <b>sous</b> (sota), <b>chez</b> (a casa de)."
      },
      "exercices": [
        {
          "phrase": "Je vais ___ Barcelone.",
          "reponse": "à"
        },
        {
          "phrase": "Elle habite ___ France.",
          "reponse": "en"
        },
        {
          "phrase": "Nous allons ___ Canada.",
          "reponse": "au"
        },
        {
          "phrase": "Le livre est ___ la table.",
          "reponse": "sur"
        },
        {
          "phrase": "Le chat est ___ la chaise.",
          "reponse": "sous"
        },
        {
          "phrase": "Je suis ___ moi ce soir.",
          "reponse": "chez"
        },
        {
          "phrase": "Les clés sont ___ le sac.",
          "reponse": "dans"
        },
        {
          "phrase": "Il revient ___ Québec. (provincia)",
          "reponse": "au"
        }
      ]
    }
  ]
}