    {
      "titre": {
        "es": "La R française — gutural",
        "ca": "La R francesa — gutural"
      },
      "description": {
        "es": "La <b>R</b> francesa se hace en la garganta (como hacer gárgaras suave), no con la punta de la lengua.",
        "ca": "La <b>R</b> francesa es fa a la gola (com fer gàrgares suau), no amb la punta de la llengua."
      },
      "exemples": [
        {
          "mot": "rouge",
          "es": "rojo",
          "ca": "vermell"
        },
        {
          "mot": "Paris",
          "es": "París",
          "ca": "París"
        },
        {
          "mot": "merci",
          "es": "gracias",
          "ca": "gràcies"
