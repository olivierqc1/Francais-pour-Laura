  "exercices": [
    { "phrase": "Je ___ étudiante de français. (être)", "reponse": "suis", "options": ["suis", "es", "est", "sont"], "explication": { "es": "Je → suis. 'Je suis' = Soy / Estoy.", "ca": "Je → suis. 'Je suis' = Sóc / Estic." } },
    { "phrase": "Tu ___ un beau pays, le Québec ! (avoir)", "reponse": "as", "options": ["as", "ai", "a", "avons"], "explication": { "es": "Tu → as. 'Tu as' = Tienes.", "ca": "Tu → as. 'Tu as' = Tens." } },
    { "phrase": "Montréal ___ la plus grande ville du Québec. (être)", "reponse": "est", "options": ["est", "es", "êtes", "sont"], "explication": { "es": "Il/Elle → est. Montréal (elle) → est.", "ca": "Il/Elle → est. Montréal (elle) → est." } },
    { "phrase": "Nous ___ de la chance de vivre ici. (avoir)", "reponse": "avons", "options": ["avons", "ont", "avez", "ai"], "explication": { "es": "Nous → avons. 'Nous avons' = Tenemos.", "ca": "Nous → avons. 'Nous avons' = Tenim." } },
