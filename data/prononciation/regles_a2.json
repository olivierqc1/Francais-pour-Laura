          "ca": "carrer"
        },
        {
          "mot": "travailler",
          "es": "trabajar",
          "ca": "treballar"
        }
      ]
    },
    {
      "titre": {
        "es": "La H muette — la H no se pronuncia",
        "ca": "La H muda — la H no es pronuncia"
      },
      "description": {
        "es": "La <b>H</b> casi nunca se pronuncia. La «h muette» permite liaison (les hôtels), la «h aspirée» no (les héros).",
        "ca": "La <b>H</b> gairebé mai es pronuncia. La «h muette» permet liaison (les hôtels), la «h aspirée» no (les héros)."
      },
      "exemples": [
