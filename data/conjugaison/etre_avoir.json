        { "pronom": "tu", "forme": "es", "tts": "tu es", "es": "tú eres / estás", "ca": "tu ets / estàs" },
        { "pronom": "il / elle / on", "forme": "est", "tts": "il est", "es": "él es / está", "ca": "ell és / està" },
        { "pronom": "nous", "forme": "sommes", "tts": "nous sommes", "es": "nosotros somos / estamos", "ca": "nosaltres som / estem" },
        { "pronom": "vous", "forme": "êtes", "tts": "vous êtes", "es": "vosotros sois / estáis", "ca": "vosaltres sou / esteu" },
        { "pronom": "ils / elles", "forme": "sont", "tts": "ils sont", "es": "ellos son / están", "ca": "ells són / estan" }
      ]
    },
    {
      "infinitif": "avoir",
