    {
      "titre": {
        "es": "Les consonnes finales muettes (D, T, S, X, P...)",
        "ca": "Les consonants finals mudes (D, T, S, X, P...)"
      },
      "description": {
        "es": "La mayoría de consonantes finales NO se pronuncian. Aquí el famoso <b>P muet</b> de <i>trop, beaucoup, loup</i>.",
        "ca": "La majoria de consonants finals NO es pronuncien. Aquí la famosa <b>P muda</b> de <i>trop, beaucoup, loup</i>."
