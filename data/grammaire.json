{
  "modules": [
    {
      "id": "articles",
      "titre": {
        "es": "Los artículos",
        "ca": "Els articles"
      },
      "explication": {
        "es": "<b>Definidos</b>: le (m), la (f), les (pl). <b>Indefinidos</b>: un, une, des. <b>Partitivos</b> (una cantidad indefinida — ¡no existe en español!): du (m), de la (f), de l' (ante vocal), des (pl).",
        "ca": "<b>Definits</b>: le (m), la (f), les (pl). <b>Indefinits</b>: un, une, des. <b>Partitius</b> (una quantitat indefinida — no existeix en castellà!): du (m), de la (f), de l' (davant vocal), des (pl)."
      },
      "exercices": [
        {
          "phrase": "J'aime ___ hockey.",
          "reponse": "le"
        },
        {
          "phrase": "Elle regarde ___ télévision.",
          "reponse": "la"
        },
        {
          "phrase": "Nous visitons ___ musées.",
          "reponse": "les"
        },
        {
          "phrase": "Il y a ___ chat dans le jardin.",
          "reponse": "un"
        },
        {
          "phrase": "Je voudrais ___ pomme, s'il vous plaît.",
          "reponse": "une"
        },
        {
          "phrase": "Il achète ___ légumes au marché.",
          "reponse": "des"
        },
        {
          "phrase": "Je mange ___ poutine au restaurant.",
          "reponse": "de la"
        },
        {
          "phrase": "Tu bois ___ café ?",
          "reponse": "du"
        },
        {
          "phrase": "Elle boit ___ eau.",
          "reponse": "de l'"
        }
      ]
    },
    {
      "id": "negation",
      "titre": {
        "es": "La negación",
        "ca": "La negació"
      },
      "explication": {
        "es": "La negación se forma con <b>ne + verbo + pas</b>. Variantes: <b>ne...jamais</b> (nunca), <b>ne...plus</b> (ya no), <b>ne...rien</b> (nada), <b>ne...personne</b> (nadie). En Quebec el «ne» a menudo no se pronuncia, ¡pero sí se escribe!",
        "ca": "La negació es forma amb <b>ne + verb + pas</b>. Variants: <b>ne...jamais</b> (mai), <b>ne...plus</b> (ja no), <b>ne...rien</b> (res), <b>ne...personne</b> (ningú). Al Quebec el «ne» sovint no es pronuncia, però s'escriu!"
      },
      "exercices": [
        {
          "phrase": "Je ___ mange pas de viande.",
          "reponse": "ne"
        },
        {
          "phrase": "Il ne mange ___ de légumes.",
          "reponse": "pas"
        },
        {
          "phrase": "Elle ne fume ___.",
          "reponse": "jamais"
        },
        {
          "phrase": "Nous n'avons ___ d'argent.",
          "reponse": "plus"
        },
        {
          "phrase": "Je ne comprends ___.",
          "reponse": "rien"
        },
        {
          "phrase": "Tu ne bois ___ d'alcool ?",
          "reponse": "pas"
        },
        {
          "phrase": "Il n'y a ___ dans la maison.",
          "reponse": "personne"
        },
        {
          "phrase": "Ils ne sortent ___ le soir.",
          "reponse": "jamais"
        }
      ]
    },
    {
      "id": "genre_adjectifs",
      "titre": {
        "es": "El género y los adjetivos",
        "ca": "El gènere i els adjectius"
      },
      "explication": {
        "es": "El adjetivo concuerda en <b>género</b> y <b>número</b>. Femenino: a menudo +e (petit → petite). Plural: +s. Algunos son irregulares: beau → belle, blanc → blanche.",
        "ca": "L'adjectiu concorda en <b>gènere</b> i <b>nombre</b>. Femení: sovint +e (petit → petite). Plural: +s. Alguns són irregulars: beau → belle, blanc → blanche."
      },
      "exercices": [
        {
          "phrase": "La voiture est ___. (petit)",
          "reponse": "petite"
        },
        {
          "phrase": "Les fleurs sont ___. (beau)",
          "reponse": "belles"
        },
        {
          "phrase": "C'est un ___ homme. (grand)",
          "reponse": "grand"
        },
        {
          "phrase": "Une femme ___. (heureux)",
          "reponse": "heureuse"
        },
        {
          "phrase": "Les chats sont ___. (noir)",
          "reponse": "noirs"
        },
        {
          "phrase": "Une robe ___. (blanc)",
          "reponse": "blanche"
        },
        {
          "phrase": "Des livres ___. (intéressant)",
          "reponse": "intéressants"
        },
        {
          "phrase": "La neige est ___. (froid)",
          "reponse": "froide"
        }
      ]
    },
    {
      "id": "pronoms_sujets",
      "titre": {
        "es": "Los pronombres sujeto",
        "ca": "Els pronoms subjecte"
      },
      "explication": {
        "es": "<b>je</b> (yo), <b>tu</b> (tú), <b>il/elle</b> (él/ella), <b>nous</b> (nosotros), <b>vous</b> (vosotros/usted), <b>ils/elles</b> (ellos/ellas). En Quebec, <b>on</b> se usa muchísimo en lugar de «nous».",
        "ca": "<b>je</b> (jo), <b>tu</b> (tu), <b>il/elle</b> (ell/ella), <b>nous</b> (nosaltres), <b>vous</b> (vosaltres/vostè), <b>ils/elles</b> (ells/elles). Al Quebec, <b>on</b> s'usa moltíssim en lloc de «nous»."
      },
      "exercices": [
        {
          "phrase": "___ suis québécois.",
          "reponse": "je"
        },
        {
          "phrase": "___ es espagnole.",
          "reponse": "tu"
        },
        {
          "phrase": "___ mange une pomme. (él)",
          "reponse": "il"
        },
        {
          "phrase": "___ sommes à Barcelone.",
          "reponse": "nous"
        },
        {
          "phrase": "___ êtes prêts ?",
          "reponse": "vous"
        },
        {
          "phrase": "___ parlent français. (ellas)",
          "reponse": "elles"
        },
        {
          "phrase": "___ va à la cabane à sucre ! (nosotros, familiar)",
          "reponse": "on"
        },
        {
          "phrase": "Marie et Paul ? ___ arrivent demain.",
          "reponse": "ils"
        }
      ]
    },
    {
      "id": "prepositions",
      "titre": {
        "es": "Las preposiciones y el lugar",
        "ca": "Les preposicions i el lloc"
      },
      "explication": {
        "es": "<b>à</b> + ciudad (à Barcelone), <b>en</b> + país femenino (en France), <b>au</b> + país masculino (au Canada). Lugar: <b>dans</b> (dentro), <b>sur</b> (sobre), <b>sous</b> (debajo), <b>chez</b> (en casa de).",
        "ca": "<b>à</b> + ciutat (à Barcelone), <b>en</b> + país femení (en France), <b>au</b> + país masculí (au Canada). Lloc: <b>dans</b> (dins), <b>sur</b> (sobre), <b>sous</b> (sota), <b>chez</b> (a casa de)."
      },
      "exercices": [
        {
          "phrase": "Je vais ___ Barcelone.",
          "reponse": "à"
        },
        {
          "phrase": "Elle habite ___ France.",
          "reponse": "en"
        },
        {
          "phrase": "Nous allons ___ Canada.",
          "reponse": "au"
        },
        {
          "phrase": "Le livre est ___ la table.",
          "reponse": "sur"
        },
        {
          "phrase": "Le chat est ___ la chaise.",
          "reponse": "sous"
        },
        {
          "phrase": "Je suis ___ moi ce soir.",
          "reponse": "chez"
        },
        {
          "phrase": "Les clés sont ___ le sac.",
          "reponse": "dans"
        },
        {
          "phrase": "Il revient ___ Québec. (provincia)",
          "reponse": "au"
        }
      ]
    },
    {
      "id": "interrogation",
      "titre": {
        "es": "La interrogación",
        "ca": "La interrogació"
      },
      "explication": {
        "es": "Para preguntar: <b>est-ce que</b> (sí/no), o una palabra interrogativa: <b>où</b> (dónde), <b>quand</b> (cuándo), <b>comment</b> (cómo), <b>pourquoi</b> (por qué), <b>qui</b> (quién), <b>combien</b> (cuánto), <b>qu'est-ce que</b> (qué).",
        "ca": "Per preguntar: <b>est-ce que</b> (sí/no), o una paraula interrogativa: <b>où</b> (on), <b>quand</b> (quan), <b>comment</b> (com), <b>pourquoi</b> (per què), <b>qui</b> (qui), <b>combien</b> (quant), <b>qu'est-ce que</b> (què)."
      },
      "exercices": [
        {
          "phrase": "___ est-ce que tu habites ? (dónde)",
          "reponse": "où"
        },
        {
          "phrase": "___ tu t'appelles ? (cómo)",
          "reponse": "comment"
        },
        {
          "phrase": "___ vas-tu à l'école ? (cuándo)",
          "reponse": "quand"
        },
        {
          "phrase": "___ est-ce que tu pleures ? (por qué)",
          "reponse": "pourquoi"
        },
        {
          "phrase": "___ est ton ami ? (quién)",
          "reponse": "qui"
        },
        {
          "phrase": "___ ça coûte ? (cuánto)",
          "reponse": "combien"
        },
        {
          "phrase": "Qu'est-___ que tu fais ?",
          "reponse": "ce"
        },
        {
          "phrase": "___-ce que tu aimes le café ?",
          "reponse": "est"
        }
      ]
    },
    {
      "id": "possessifs",
      "titre": {
        "es": "Los adjetivos posesivos",
        "ca": "Els adjectius possessius"
      },
      "explication": {
        "es": "<b>mi</b>: mon (m) / ma (f) / mes (pl). <b>tu</b>: ton/ta/tes. <b>su</b>: son/sa/ses. <b>nuestro</b>: notre/nos. Ante vocal femenina se usa la forma masculina: <i>mon amie</i>.",
        "ca": "<b>el meu</b>: mon (m) / ma (f) / mes (pl). <b>el teu</b>: ton/ta/tes. <b>el seu</b>: son/sa/ses. <b>el nostre</b>: notre/nos. Davant de vocal femenina s'usa la forma masculina: <i>mon amie</i>."
      },
      "exercices": [
        {
          "phrase": "C'est ___ voiture. (mi, fem)",
          "reponse": "ma"
        },
        {
          "phrase": "___ frère est grand. (mi, masc)",
          "reponse": "mon"
        },
        {
          "phrase": "___ parents sont gentils. (mis)",
          "reponse": "mes"
        },
        {
          "phrase": "Où est ___ sac ? (tu, masc)",
          "reponse": "ton"
        },
        {
          "phrase": "J'aime ___ ville. (tu, fem)",
          "reponse": "ta"
        },
        {
          "phrase": "C'est ___ maison. (su, fem)",
          "reponse": "sa"
        },
        {
          "phrase": "___ enfants jouent. (sus)",
          "reponse": "ses"
        },
        {
          "phrase": "C'est ___ amie. (mi, ante vocal)",
          "reponse": "mon"
        }
      ]
    },
    {
      "id": "demonstratifs",
      "titre": {
        "es": "Los adjetivos demostrativos",
        "ca": "Els adjectius demostratius"
      },
      "explication": {
        "es": "<b>este/esta/estos</b>: ce (m), cet (m ante vocal), cette (f), ces (pl). Ej: <i>ce livre, cet homme, cette femme, ces enfants</i>.",
        "ca": "<b>aquest/aquesta/aquests</b>: ce (m), cet (m davant vocal), cette (f), ces (pl). Ex: <i>ce livre, cet homme, cette femme, ces enfants</i>."
      },
      "exercices": [
        {
          "phrase": "___ livre est intéressant. (este, masc)",
          "reponse": "ce"
        },
        {
          "phrase": "___ femme est gentille. (esta)",
          "reponse": "cette"
        },
        {
          "phrase": "___ enfants sont sages. (estos)",
          "reponse": "ces"
        },
        {
          "phrase": "___ homme est grand. (este, ante vocal)",
          "reponse": "cet"
        },
        {
          "phrase": "J'aime ___ chanson. (esta)",
          "reponse": "cette"
        },
        {
          "phrase": "___ arbre est vieux. (este, ante vocal)",
          "reponse": "cet"
        },
        {
          "phrase": "Regarde ___ étoiles ! (estas)",
          "reponse": "ces"
        },
        {
          "phrase": "___ café est bon. (este)",
          "reponse": "ce"
        }
      ]
    },
    {
      "id": "comparatif",
      "titre": {
        "es": "El comparativo",
        "ca": "El comparatiu"
      },
      "explication": {
        "es": "<b>plus...que</b> (más que), <b>moins...que</b> (menos que), <b>aussi...que</b> (tan como). Irregular: <i>bon</i> → <b>meilleur</b> (mejor).",
        "ca": "<b>plus...que</b> (més que), <b>moins...que</b> (menys que), <b>aussi...que</b> (tan com). Irregular: <i>bon</i> → <b>meilleur</b> (millor)."
      },
      "exercices": [
        {
          "phrase": "Marie est ___ grande que Paul. (más)",
          "reponse": "plus"
        },
        {
          "phrase": "Il est ___ rapide que moi. (menos)",
          "reponse": "moins"
        },
        {
          "phrase": "Elle est ___ intelligente que lui. (tan)",
          "reponse": "aussi"
        },
        {
          "phrase": "Paris est plus grand ___ Lyon.",
          "reponse": "que"
        },
        {
          "phrase": "Le café est ___ cher que le thé. (más)",
          "reponse": "plus"
        },
        {
          "phrase": "Ce film est ___ bon que l'autre. (menos)",
          "reponse": "moins"
        },
        {
          "phrase": "Tu cours aussi vite ___ moi.",
          "reponse": "que"
        },
        {
          "phrase": "Ce vin est ___ que l'autre. ('mejor', de bon)",
          "reponse": "meilleur"
        }
      ]
    },
    {
      "id": "cest_ilest",
      "titre": {
        "es": "C'est o Il est",
        "ca": "C'est o Il est"
      },
      "explication": {
        "es": "<b>C'est</b> + artículo/nombre/nombre propio (<i>c'est un médecin, c'est Paul</i>). <b>Il/Elle est</b> + adjetivo o profesión SIN artículo (<i>il est médecin, elle est gentille</i>).",
        "ca": "<b>C'est</b> + article/nom/nom propi (<i>c'est un médecin, c'est Paul</i>). <b>Il/Elle est</b> + adjectiu o professió SENSE article (<i>il est médecin, elle est gentille</i>)."
      },
      "exercices": [
        {
          "phrase": "___ un bon livre. (es + artículo)",
          "reponse": "c'est"
        },
        {
          "phrase": "___ médecin. (él es, profesión)",
          "reponse": "il est"
        },
        {
          "phrase": "___ ma sœur. (es + posesivo)",
          "reponse": "c'est"
        },
        {
          "phrase": "___ très gentille. (ella es + adj)",
          "reponse": "elle est"
        },
        {
          "phrase": "___ difficile. (es + adj, impersonal)",
          "reponse": "c'est"
        },
        {
          "phrase": "___ étudiant. (él es, profesión)",
          "reponse": "il est"
        },
        {
          "phrase": "___ Marie. (es + nombre propio)",
          "reponse": "c'est"
        },
        {
          "phrase": "___ intelligents. (ellos son + adj)",
          "reponse": "ils sont"
        }
      ]
    }
  ]
}