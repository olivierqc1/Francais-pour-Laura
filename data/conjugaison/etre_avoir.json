        { "pronom": "il / elle / on", "forme": "a", "tts": "il a", "es": "él tiene", "ca": "ell té" },
        { "pronom": "nous", "forme": "avons", "tts": "nous avons", "es": "nosotros tenemos", "ca": "nosaltres tenim" },
