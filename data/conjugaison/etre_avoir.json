    { "phrase": "Vous ___ raison, il fait froid ! (avoir)", "reponse": "avez", "options": ["avez", "avons", "ont", "as"], "explication": { "es": "Vous → avez. 'Avoir raison' = tener razón.", "ca": "Vous → avez. 'Avoir raison' = tenir raó." } },
    { "phrase": "J'___ trente ans. (avoir)", "reponse": "ai", "options": ["ai", "as", "suis", "a"], "explication": { "es": "La edad se dice con AVOIR en francés: J'ai 30 ans = Tengo 30 años.", "ca": "L'edat es diu amb AVOIR en francès: J'ai 30 ans = Tinc 30 anys." } },
    { "phrase": "On ___ contents d'apprendre le français. (être)", "reponse": "est", "options": ["est", "sont", "sommes", "es"], "explication": { "es": "'On' siempre lleva la forma de il/elle → est. 'On est contents' = Estamos contentos.", "ca": "'On' sempre porta la forma de il/elle → est. 'On est contents' = Estem contents." } }
